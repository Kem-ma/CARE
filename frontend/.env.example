# After `cdk deploy`, copy the values the four stacks print as "Outputs" into a file
# named .env.local in this folder (it is git-ignored). None of these are secrets.
#
#   ApiUrl            -> VITE_API_URL            (CsirsApiStack)
#   WebSocketUrl      -> VITE_WS_URL             (CsirsAlertingStack)
#   CitizenPoolId     -> VITE_CITIZEN_POOL_ID    (CsirsAuthStack)
#   CitizenClientId   -> VITE_CITIZEN_CLIENT_ID  (CsirsAuthStack)
#   AdminPoolId       -> VITE_ADMIN_POOL_ID      (CsirsAuthStack)
#   AdminClientId     -> VITE_ADMIN_CLIENT_ID    (CsirsAuthStack)
#
# On Amplify Hosting, add the same six names under Hosting > Environment variables.

VITE_API_URL=
VITE_WS_URL=
VITE_CITIZEN_POOL_ID=
VITE_CITIZEN_CLIENT_ID=
VITE_ADMIN_POOL_ID=
VITE_ADMIN_CLIENT_ID=
